@inherits SettingComponentBase
@inject LinuxHelper LinuxHelper

<MudContainer Class="pa-0">
    <MudLink Color="Color.Default" Underline="Underline.None" Disabled="Disabled" Class="@(GetLinkClasses())">
            <MudSelect T="string" Value="@NewValue" ValueChanged="@OnValueChanged"
                    Label="@(LocaleHelper.Get("linux_proton_version"))" Variant="Variant.Outlined" Margin="Margin.Dense"
                    PopoverClass="limited-height-select" Style="margin-right: 20px;"
                    Error="@(HasError)" ErrorText="@(LocaleHelper.Get("setting_help_proton"))">
                @foreach (var item in Options)
                {
                    <MudSelectItem Value="@item">@item</MudSelectItem>
                }
            </MudSelect>
    </MudLink>
    <a class="d-flex justify-center align-center py-2 px-5">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" 
                OnClick="AddProtonPath" Color="Color.Primary" Size="Size.Small">
            Label=@LocaleHelper.Get("linux_add_proton_path")
        </MudButton>
    </a>
</MudContainer>
@if (AddDiv)
{
    <MudDivider DividerType="DividerType.Middle" Class="ma-0"/>
}

@code {

    private List<string> Options { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        NewValue = ConfigHelper.GetConfig().LinuxSettings.ProtonVersion;
        Options = await LinuxHelper.GetProtonVersions();
        HasError = !ValidateValue();

        await base.OnInitializedAsync();
    }

    private async Task AddProtonPath()
    {
        var folder = await Launcher.App.MainWindow.ShowOpenFolderAsync(
            title: "Choose Folder",
            defaultPath: FilePickerHelper.StartDirectory(NewValue)
        );

        // no folder was selected
        if (!folder.Any())
        {
            return;
        }

        var folderPath = folder.FirstOrDefault("");

        if (!ConfigHelper.AddLinuxProtonSearchPath(folderPath))
        {
            Snackbar.Add(LocaleHelper.Get("setting_save_path_error_2"), Severity.Warning);
            return;
        }

        Snackbar.Add(LocaleHelper.Get("setting_save_path_success"), Severity.Success);
        
        Options = await LinuxHelper.GetProtonVersions();
        NewValue = Options.FirstOrDefault(ConfigHelper.GetConfig().LinuxSettings.ProtonVersion);

        await Save();
    }

    protected override async Task SaveValue()
    {
        ConfigHelper.SetLinuxProtonVersion(NewValue);
    }

    protected override bool ValidateValue()
    {
        return ConfigHelper.IsProtonVersionValid(NewValue);
    }

    private async Task OnValueChanged(string value)
    {
        NewValue = value;
        await Save();
    }
}